{
  "manifest_version": 3,
  "name": "Kidi AI",
  "short_name": "Kidi AI",
  "description": "Polish, explain, and summarize selected text using a private on-device model.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "menus",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "background.mjs"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Open Kidi AI"
  },
  "sidebar_action": {
    "default_title": "Kidi AI",
    "default_panel": "editor.html",
    "default_icon": "icons/kidi-logo.png"
  },
  "icons": {
    "128": "icons/kidi-logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kidi@gowda.ai",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
