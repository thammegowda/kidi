{
  "manifest_version": 3,
  "name": "Kidi AI",
  "short_name": "Kidi AI",
  "description": "Polish, explain, and summarize selected text using a private on-device model.",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Open Kidi AI"
  },
  "side_panel": {
    "default_path": "editor.html"
  },
  "icons": {
    "128": "icons/kidi-logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self';"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
